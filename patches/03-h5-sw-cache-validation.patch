+// [fix H5] A video cache is keyed by `m` only. Once per SW instance, before serving a
+// video whose metadata came from an earlier session, check that the origin still has
+// the same file (size + ETag/Last-Modified). On mismatch drop the whole cache of `m`,
+// so chunks of two different files are never mixed.
+const revalidatedMParams = new Set();
+async function revalidateCache(mParam, url) {
+    if (revalidatedMParams.has(mParam)) return;
+    revalidatedMParams.add(mParam);
+    const meta = await getMetadata(mParam);
+    if (!meta?.totalSize) return;
+    try {
+        const r = await fetch(url, { headers: { 'Range': 'bytes=0-0' } });
+        try { await r.body.cancel(); } catch (e) {}
+        if (r.status !== 206) return;
+        const total = +((r.headers.get('Content-Range') || '').split('/')[1]);
+        const validator = r.headers.get('ETag') || r.headers.get('Last-Modified') || null;
+        const changed = (total && total !== meta.totalSize) || (validator && meta.validator && validator !== meta.validator) || (validator && !meta.validator);
+        if (changed) {
+            logError('[SEEK-DIAG] cache of m=', mParam, 'is stale (size', meta.totalSize, '->', total, 'validator', meta.validator, '->', validator, '), deleting');
+            await deleteVideoCache(getCacheName(mParam), mParam);
+        }
+    } catch (e) { /* network trouble: keep the cache, serve() handles the origin */ }
+}
