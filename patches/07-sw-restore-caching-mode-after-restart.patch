 // turns this on (with setVideoMode) only for the singlethread/multithread modes, so
 // an "auto"/"simple" user never gets SW caching even before any message arrives.
 let videoCachingEnabled = false; // Global flag to enable/disable video caching (set by page via postMessage)
+// [fix SW restart] The page sends setVideoCachingEnabled/setVideoMode only on load and on
+// controllerchange. When the browser stops an idle SW (e.g. during a pause) the next
+// instance would silently bypass caching until the page is reloaded. Persist the last
+// mode the page chose and restore it when a new instance starts.
+const SETTINGS_KEY = 'https://cache.local/settings';
+let settingsLoaded = false;
+const settingsReady = (async () => {
+    try {
+        const r = await (await caches.open(CACHE_META_NAME)).match(SETTINGS_KEY);
+        if (r && !settingsLoaded) {
+            const st = await r.json();
+            videoCachingEnabled = !!st.enabled;
+            if (st.mode === 'singlethread' || st.mode === 'multithread') videoMode = st.mode;
+            log('[SW] restored video settings: caching=', videoCachingEnabled, 'mode=', videoMode);
+        }
+    } catch (e) { /* keep defaults */ }
+    settingsLoaded = true;
+})();
+function persistSettings() {
+    settingsLoaded = true; // an explicit message from the page wins over the stored value
+    return caches.open(CACHE_META_NAME)
+        .then(c => c.put(SETTINGS_KEY, new Response(JSON.stringify({ enabled: videoCachingEnabled, mode: videoMode }))))
+        .catch(() => {});
+}
